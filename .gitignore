# ---- Binary artifacts --------------------------------------------------------
# Dependency jars are fetched from their official distribution (see README),
# never committed. The Gradle wrapper jar is the one exception.
*.jar
!gradle/wrapper/gradle-wrapper.jar

# ---- Local Windows launcher scripts ------------------------------------------
# The mod itself builds with ./gradlew (or gradlew.bat on Windows).
/*.bat
/*.exe
!/gradlew.bat

