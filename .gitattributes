# Normalize all text files to LF in the repository, so the tree is identical
# regardless of which platform it was committed from.
* text=auto eol=lf

# Windows scripts must keep CRLF or cmd.exe mis-parses them.
*.bat text eol=crlf

# Never touch binary files.
*.jar binary
*.png binary
*.ogg binary
*.zip binary

# Disable autocrlf on generated files, they always generate with LF
# Add any extra files or paths here to make git stop saying they
# are changed when only line endings change.
src/generated/**/.cache/cache text eol=lf
src/generated/**/*.json text eol=lf
